# Navigators Production Environment Variables
# Copy this file to .env.production and modify before running docker-compose

# Security
JWT_SECRET=replace_this_with_a_long_secure_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database
# Default uses local SQLite. 
# For PostgreSQL use: postgresql://user:password@hostname:5432/navigators
DATABASE_URL=sqlite:///./navigators_cloud.db

# CORS Configuration
# Set to the actual domain of your frontend deployment
CORS_ORIGINS=["https://yourdomain.com", "https://www.yourdomain.com"]

# Environment
ENV=production
DEBUG=false
